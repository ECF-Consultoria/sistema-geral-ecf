APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Flag ADR DATA-04 - habilita enriquecimento multi-fonte nos dashboards; default false
UNIFIED_METRICS_ENABLED=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Em produção (VPS), usar DB separados para isolar chaves de outros sistemas:
REDIS_DB=1
REDIS_CACHE_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Configuração SMTP para Google Workspace (produção) ─────────────────────
# Para usar Google Workspace como SMTP, configure as variáveis abaixo:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=seu-email@seudominio.com
#   MAIL_PASSWORD=app-password-gerado-no-google
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS=seu-email@seudominio.com
#   MAIL_FROM_NAME="${APP_NAME}"
# Gere a senha de app em: https://myaccount.google.com/apppasswords

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Caminho do Chrome/Chromium para geração de PDF (Browsershot)
# Windows (local): C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux (VPS Ubuntu): /usr/bin/chromium-browser
CHROME_BINARY_PATH=/usr/bin/chromium-browser

# ECF Drive (Phase 20 — substitui sync SFTP do ML por API HTTP)
# API que abstrai o SFTP do Mercado Livre e expõe grants via REST autenticado.
# API key gerada no painel do ECF Drive (formato: ecf_<64 hex>). NUNCA commitar.
ECF_API_BASE=https://files.ecfconsultoria.com.br/api/v1
ECF_API_KEY=
# Webhook secret (deferido para Phase 21 — manter vazio nesta fase)
ECF_WEBHOOK_SECRET=

# HubSpot — Phase 34 Plan 34-04 (webhook deal.closedwon → cadastro automático).
# CLIENT_SECRET: usado para validar HMAC v3 dos webhooks (App Settings → Auth).
# ACCESS_TOKEN: Private App token Bearer para GET /crm/v3/objects/*.
# STAGE_FECHADO_GANHO_ID: id interno do dealstage gatilho no pipeline HubSpot.
# Os HUBSPOT_PROP_* permitem remapear cada propriedade caso o cliente use nomes
# customizados (deixar default cobre o cenário padrão da ECF).
HUBSPOT_CLIENT_SECRET=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_STAGE_FECHADO_GANHO_ID=closedwon
HUBSPOT_PROP_DEAL_SERVICO=servico_ecf
HUBSPOT_PROP_COMPANY_NAME=name
HUBSPOT_PROP_COMPANY_CNPJ=cnpj
HUBSPOT_PROP_COMPANY_EMAIL=email
HUBSPOT_PROP_COMPANY_PHONE=phone
# Phase 35 Plan 35-02 — contato vinculado ao deal (fallback p/ email/telefone).
HUBSPOT_PROP_CONTACT_FIRSTNAME=firstname
HUBSPOT_PROP_CONTACT_LASTNAME=lastname
HUBSPOT_PROP_CONTACT_EMAIL=email
HUBSPOT_PROP_CONTACT_PHONE=phone
# Quick task 260805-eqk — Origem do lead vive no CONTATO (não no deal/company).
HUBSPOT_PROP_CONTACT_ORIGEM_LEAD=origem_do_lead
HUBSPOT_PROP_CONTACT_CAMPANHA_ORIGEM=campanha_origem
HUBSPOT_PROP_CONTACT_CRIATIVO_ORIGEM=criativo_origem
# Quick task 260805-eqk — Notes (observações) associadas ao DEAL.
HUBSPOT_PROP_NOTE_BODY=hs_note_body
HUBSPOT_PROP_NOTE_TIMESTAMP=hs_timestamp

# Phase 40 — CSV de company_ids elegíveis para shadow mode ML (Sugadores).
# Vazio = scheduler diário não roda shadow pra ninguém (use --company={id} manual).
# Ex.: SUGADORES_ML_SHADOW_COMPANIES=10,20,42
SUGADORES_ML_SHADOW_COMPANIES=

# ─── Digisac (WhatsApp) — v15.5 NPS canal WhatsApp ────────────────────────
# Integração usada pelo envio mensal de NPS via WhatsApp (opt-in por config
# de admin em /nps/envio-automatico). Vazio = canal Digisac permanece desligado
# mesmo que o admin ative o toggle (o dispatcher falha graceful com log).
# BASE_URL: ex. https://ecf.digisac.chat (SEM /api/v1 no final)
# TOKEN: Bearer token da Private App Digisac
# DEFAULT_SERVICE_ID: conexão WhatsApp default usada quando a empresa não define uma
# DEFAULT_USER_ID: usuário Digisac que aparece como origem do envio (bot)
DIGISAC_BASE_URL=
DIGISAC_TOKEN=
DIGISAC_DEFAULT_SERVICE_ID=
DIGISAC_DEFAULT_USER_ID=
DIGISAC_TIMEOUT=15
DIGISAC_ORIGIN=bot

# NPS Anti-Burlamento (Phase 94)
# IPs/CIDRs da rede interna ECF (separados por vírgula) usados pelo
# NpsSuspicionService (Regra 1) para marcar respostas como suspeitas.
# Configuração pela UI é Fase 96 — aqui é 100% .env.
# Ex.: ECF_INTERNAL_IPS=201.10.20.30,189.40.50.60
# Ex.: ECF_INTERNAL_CIDRS=10.0.0.0/8,192.168.0.0/16
ECF_INTERNAL_IPS=
ECF_INTERNAL_CIDRS=
# Janela (segundos) para considerar uma resposta "rápida demais" após a
# geração do link (Regra 2).
NPS_SUSPICION_WINDOW_SECONDS=60

# ─── Shopee Open Platform (API v2) ────────────────────────────────────────
# Credenciais do app de parceiro (console open.shopee.com). partner_id é
# numérico; partner_key é a chave HMAC secreta usada para assinar TODA request.
# ⚠️ SHOPEE_HOST: confirmar o host da sua região no console.
#    - Global (default): https://partner.shopeemobile.com
#    - Regional BR (se aplicável): https://openplatform.shopee.com.br
#    - Sandbox (validado): https://openplatform.sandbox.test-stable.shopee.sg
# ⚠️ SHOPEE_REDIRECT_URI precisa estar cadastrada no app da Shopee.
# São DOIS apps (categorias não coabitam): ERP System (pedidos/faturamento) e
# Ads Service (performance de anúncios). Cada um tem partner_id/key/redirect
# próprios; host/verify_ssl são compartilhados. O cliente autoriza os dois via
# consent encadeado. Os SHOPEE_PARTNER_ID/KEY/REDIRECT_URI abaixo são fallback
# do app ERP (retrocompat) — pode migrar para os SHOPEE_ERP_* explícitos.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_HOST=https://partner.shopeemobile.com
SHOPEE_REDIRECT_URI=https://desafio.ecfconsultoria.com.br/oauth/shopee/callback
SHOPEE_VERIFY_SSL=true
# App ERP (opcional — sobrescreve o fallback acima)
SHOPEE_ERP_PARTNER_ID=
SHOPEE_ERP_PARTNER_KEY=
SHOPEE_ERP_REDIRECT_URI=https://desafio.ecfconsultoria.com.br/oauth/shopee/callback
# App Ads Service (registrar o redirect /oauth/shopee/ads/callback no console)
SHOPEE_ADS_PARTNER_ID=
SHOPEE_ADS_PARTNER_KEY=
SHOPEE_ADS_REDIRECT_URI=https://desafio.ecfconsultoria.com.br/oauth/shopee/ads/callback

# Clicksign — milestone v22.0 (Administrativo + Clicksign)
# CLICKSIGN_ENV: sandbox | producao
# Base: sandbox https://sandbox.clicksign.com/api/v3 | producao https://app.clicksign.com/api/v3
# ATENCAO: o token vai PURO no header Authorization, sem prefixo "Bearer".
# Nao usar Http::withToken() do Laravel — ele prefixa "Bearer" e a API devolve 401.
# O e-mail do usuario da API precisa estar salvo em Configuracoes -> API, senao a API devolve 403.
CLICKSIGN_ENV=sandbox
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com/api/v3
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_WEBHOOK_SECRET=
CLICKSIGN_API_USER_EMAIL=
