APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Em produção (VPS), usar DB separados para isolar chaves de outros sistemas:
REDIS_DB=1
REDIS_CACHE_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Configuração SMTP para Google Workspace (produção) ─────────────────────
# Para usar Google Workspace como SMTP, configure as variáveis abaixo:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=seu-email@seudominio.com
#   MAIL_PASSWORD=app-password-gerado-no-google
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS=seu-email@seudominio.com
#   MAIL_FROM_NAME="${APP_NAME}"
# Gere a senha de app em: https://myaccount.google.com/apppasswords

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Caminho do Chrome/Chromium para geração de PDF (Browsershot)
# Windows (local): C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux (VPS Ubuntu): /usr/bin/chromium-browser
CHROME_BINARY_PATH=/usr/bin/chromium-browser

# ECF Drive (Phase 20 — substitui sync SFTP do ML por API HTTP)
# API que abstrai o SFTP do Mercado Livre e expõe grants via REST autenticado.
# API key gerada no painel do ECF Drive (formato: ecf_<64 hex>). NUNCA commitar.
ECF_API_BASE=https://files.ecfconsultoria.com.br/api/v1
ECF_API_KEY=
# Webhook secret (deferido para Phase 21 — manter vazio nesta fase)
ECF_WEBHOOK_SECRET=
